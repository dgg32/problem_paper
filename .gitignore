# Secrets / local config
.env.yaml
.env
.mcp.json
.claude/settings.local.json

# Data & DB artifacts
data/
*.ladybug
*.db

# Source dataset (62MB, third-party Retraction Watch data -- not generated by
# this repo; document how to obtain it in README instead of committing it)
retraction_watch/*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (belt-and-suspenders; .kilo/.gitignore already excludes its own
# node_modules, this covers any other tool that drops one elsewhere)
node_modules/

# OS cruft
.DS_Store

# Browser automation session output (playwright MCP logs/screenshots)
.playwright-mcp/
